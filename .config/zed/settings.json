// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "remove_trailing_whitespace_on_save": false,
  "disable_ai": false,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "single_file_review": true,
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "enable_thinking": false,
      "provider": "copilot_chat",
      "model": "gemini-3.1-pro-preview",
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "gemini-3.1-pro-preview",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "enable_next_edit_suggestions": true
    },
    "provider": "copilot",
  },
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": [
          "upb/gwdg.qwen3.5-397b-a17b",
          "upb/openai.gpt-5.4",
          "upb/openai.gpt-5.3-codex"
        ]
      },
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "github-copilot": {
      "favorite_models": [
        "claude-opus-4.6",
        "gpt-5.2-codex",
        "gemini-3-pro-preview",
      ],
      "type": "registry",
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "file_icons": true,
  },
  "tab_size": 4,
  "format_on_save": "off",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "inlay_hints": {
    "enabled": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "autoscroll_on_clicks": true,
  "sticky_scroll": {
    "enabled": false,
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "colorize_brackets": true,
  "auto_update": false,
  "ui_font_size": 18,
  "buffer_font_family": "Hack Nerd Font",
  "buffer_font_size": 18,
  "theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "autosave": "on_focus_change",
  "toolbar": {
    "code_actions": false,
    "selections_menu": true,
    "breadcrumbs": false,
    "quick_actions": false,
  },

  "languages": {
    "LaTeX": {
      "inlay_hints": {
        "enabled": false
      },
      "soft_wrap": "editor_width"
    },
    "JavaScript": {
      "tab_size": 2,
    },
    "JSON": {
      "tab_size": 2,
    },
    "JSONC": {
      "tab_size": 2,
    },
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": false
          }
        }
      }
    }
  }
}
