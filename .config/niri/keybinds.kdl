binds {
    // ###############################################################################
    // ##! Actions

    Mod+Slash { spawn "noctalia" "msg" "bar-toggle"; }
    Ctrl+Alt+Delete { spawn "noctalia" "msg" "panel-open" "session"; }
    // Alt+Tab { spawn "noctalia" "msg" "window-switcher"; }

    Mod+X { close-window; }
    Mod+Alt+M { quit; }

    // Copilot key placeholder (Niri matches standard XKB keys; release hooks require shell scripts)
    // Mod+Shift+XF86Launch2 { spawn "voxtype" "record" "start"; } 
    // Mod+P { spawn "kitty" "--class" "hyprmoncfg" "-e" "hyprmoncfg"; }

    Mod+Alt+L { spawn "loginctl" "lock-session"; }
    Mod+Alt+Shift+L allow-when-locked=true { spawn "systemctl" "suspend"; }

    // Layout Stacking (Translates Hyprland Groups -> Niri Tabbed Columns)
    Mod+T { toggle-column-tabbed-display; }
    Mod+G { focus-window-down; }
    Mod+Alt+G { focus-window-up; }

    // Screenshot & Tools
    Mod+Alt+Shift+S { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Ctrl+Shift+Print { spawn-sh "grim -g \"$(slurp $SLURP_ARGS)\" tmp.png && tesseract -l eng tmp.png - | wl-copy && rm tmp.png"; }
    Mod+Shift+C { spawn "hyprpicker" "-a"; }
    
    // Recording scripts
    Mod+Alt+R { spawn-sh "~/.config/hypr/scripts/record.sh --fullscreen-sound"; }
    Mod+Shift+R { spawn-sh "~/.config/hypr/scripts/record.sh --fullscreen"; }
    Mod+Shift+Ctrl+R { spawn-sh "~/.config/hypr/scripts/record.sh"; }
    
    // Screenshots
    Print { spawn "flameshot" "gui"; }
    Ctrl+Print { spawn "hyprshot" "-m" "region" "--clipboard-only"; }
    Mod+Print { spawn "hyprshot" "-m" "window"; }
    Mod+Ctrl+Print { spawn "hyprshot" "-m" "window" "--clipboard-only"; }
    Alt+Print { spawn "hyprshot" "-m" "output" "-m" "eDP-1"; }
    Alt+Ctrl+Print { spawn "hyprshot" "-m" "output" "-m" "eDP-1" "--clipboard-only"; }

    // ##################################################################################
    // ##! Window management

    // Move/Swap windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // Focus directional
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Ribbon Column Resizing
    Mod+Semicolon  { set-column-width "-10%"; }
    Mod+Apostrophe { set-column-width "+10%"; }
        
    Mod+B { consume-or-expel-window-left; }
    // Mod+Period { consume-or-expel-window-right; }

    // Positioning Mode
    Mod+F { fullscreen-window; }
    Mod+D { maximize-column; }
    Mod+Alt+Space { toggle-window-floating; }

    // ##################################################################################
    // ##! Workspace management (Multi-Monitor Native Mapping)

    // Switch workspaces 1-10 on Laptop Monitor (eDP-1)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // Switch workspaces 1-10 on External Monitor (DP-1) [Old 11-20 keys from keybinds.lua]
    Mod+Alt+1 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 1"; }
    Mod+Alt+2 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 2"; }
    Mod+Alt+3 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 3"; }
    Mod+Alt+4 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 4"; }
    Mod+Alt+5 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 5"; }
    Mod+Alt+6 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 6"; }
    Mod+Alt+7 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 7"; }
    Mod+Alt+8 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 8"; }
    Mod+Alt+9 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 9"; }
    Mod+Alt+0 { spawn-sh "niri msg action focus-monitor DP-1 && niri msg action focus-workspace 10"; }

    // Move window to workspace + focus it on Laptop Monitor (eDP-1) [Follow]
    Mod+Shift+1 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 1 && niri msg action focus-workspace 1"; }
    Mod+Shift+2 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 2 && niri msg action focus-workspace 2"; }
    Mod+Shift+3 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 3 && niri msg action focus-workspace 3"; }
    Mod+Shift+4 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 4 && niri msg action focus-workspace 4"; }
    Mod+Shift+5 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 5 && niri msg action focus-workspace 5"; }
    Mod+Shift+6 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 6 && niri msg action focus-workspace 6"; }
    Mod+Shift+7 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 7 && niri msg action focus-workspace 7"; }
    Mod+Shift+8 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 8 && niri msg action focus-workspace 8"; }
    Mod+Shift+9 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 9 && niri msg action focus-workspace 9"; }
    Mod+Shift+0 { spawn-sh "niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 10 && niri msg action focus-workspace 10"; }

    // Move window to workspace + focus it on External Monitor (DP-1) [Follow]
    Mod+Alt+Shift+1 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 1 && niri msg action focus-workspace 1"; }
    Mod+Alt+Shift+2 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 2 && niri msg action focus-workspace 2"; }
    Mod+Alt+Shift+3 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 3 && niri msg action focus-workspace 3"; }
    Mod+Alt+Shift+4 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 4 && niri msg action focus-workspace 4"; }
    Mod+Alt+Shift+5 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 5 && niri msg action focus-workspace 5"; }
    Mod+Alt+Shift+6 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 6 && niri msg action focus-workspace 6"; }
    Mod+Alt+Shift+7 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 7 && niri msg action focus-workspace 7"; }
    Mod+Alt+Shift+8 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 8 && niri msg action focus-workspace 8"; }
    Mod+Alt+Shift+9 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 9 && niri msg action focus-workspace 9"; }
    Mod+Alt+Shift+0 { spawn-sh "niri msg action move-window-to-monitor DP-1 && niri msg action focus-monitor DP-1 && niri msg action move-column-to-workspace 10 && niri msg action focus-workspace 10"; }
    
    // Move window to workspace 1-10 on Laptop Monitor (eDP-1) [Silent / Focus Preserved via jq]
    Mod+Ctrl+Shift+1 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 1 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+2 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 2 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+3 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 3 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+4 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 4 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+5 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 5 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+6 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 6 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+7 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 7 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+8 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 8 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+9 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 9 && niri msg action focus-monitor $cur"; }
    Mod+Ctrl+Shift+0 { spawn-sh "cur=$(niri msg --json focused-output | jq -r .name); niri msg action move-window-to-monitor eDP-1 && niri msg action focus-monitor eDP-1 && niri msg action move-column-to-workspace 10 && niri msg action focus-monitor $cur"; }

    // Relative Workspace Navigation
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Shift+Page_Down { spawn-sh "niri msg action move-window-to-workspace-down && niri msg action focus-workspace-down"; }
    Mod+Shift+Page_Up   { spawn-sh "niri msg action move-window-to-workspace-up && niri msg action focus-workspace-up"; }    
    
    // ##################################################################################
    // ##! Apps
    
    Mod+R { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+I { spawn "systemsettings"; }
    Ctrl+Shift+Escape { spawn "kitty" "-e" "btop"; }
    Mod+E { spawn "dolphin"; }
    Mod+Z { spawn "zen-browser"; }
    Mod+O { spawn "obsidian"; }
    Mod+Return { spawn "kitty"; }
    Mod+Equal { spawn "speedcrunch"; }
    Mod+Backslash { spawn "zeditor"; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Period { spawn "plasma-emojier"; }

    // Media and System Controls
    XF86AudioRaiseVolume { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down"; }

    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }
}