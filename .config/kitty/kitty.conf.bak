# Fonts
font_family      Hack Nerd Font
font_size        13
bold_font        auto
italic_font      auto
bold_italic_font auto

tab_bar_edge top
# tab_bar_style  powerline
# tab_powerline_style  round
# tab_separator  " | "
tab_fade 0.5 0.75 1 1


# share_connections yes


# BEGIN_KITTY_THEME
# Catppuccin-Latte
include current-theme.conf
# END_KITTY_THEME

